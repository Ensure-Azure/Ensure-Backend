generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model fraud_cases {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transaction_id      String            @unique @db.Uuid
  score               Int
  threshold           Int
  status              fraud_case_status @default(OPEN)
  explanation         String?
  assigned_analyst_id String?           @db.Uuid
  reviewed_at         DateTime?         @db.Timestamptz(6)
  resolution_notes    String?
  created_at          DateTime          @default(now()) @db.Timestamptz(6)
  updated_at          DateTime          @default(now()) @db.Timestamptz(6)
  transactions        transactions      @relation(fields: [transaction_id], references: [id], onUpdate: NoAction, map: "fraud_cases_transaction_fk")
  rule_executions     rule_executions[]

  @@index([assigned_analyst_id], map: "idx_fraud_cases_assigned_analyst")
  @@index([created_at(sort: Desc)], map: "idx_fraud_cases_created_at")
  @@index([status], map: "idx_fraud_cases_status")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model fraud_settings {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  setting_key   String   @unique @db.VarChar(100)
  setting_value Json
  description   String?
  updated_by    String?  @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model risk_merchants {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchant_id   String?  @unique @db.VarChar(100)
  merchant_name String?  @db.VarChar(150)
  category_code String?  @db.VarChar(20)
  risk_points   Int
  reason        String
  active        Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([active], map: "idx_risk_merchants_active")
  @@index([category_code], map: "idx_risk_merchants_category")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model rule_executions {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fraud_case_id String      @db.Uuid
  rule_type     rule_type
  points        Int
  reason        String
  evidence      Json        @default("{}")
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  fraud_cases   fraud_cases @relation(fields: [fraud_case_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "rule_executions_case_fk")

  @@index([fraud_case_id], map: "idx_rule_executions_case")
  @@index([evidence], map: "idx_rule_executions_evidence", type: Gin)
  @@index([rule_type], map: "idx_rule_executions_type")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model transactions {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transaction_id         String             @unique @db.Uuid
  account_id             String             @db.VarChar(100)
  type                   transaction_type
  amount_minor           BigInt
  currency               String             @db.Char(3)
  occurred_at            DateTime           @db.Timestamptz(6)
  received_at            DateTime           @default(now()) @db.Timestamptz(6)
  latitude               Decimal            @db.Decimal(9, 6)
  longitude              Decimal            @db.Decimal(9, 6)
  country_code           String?            @db.Char(2)
  city                   String?            @db.VarChar(100)
  merchant_id            String?            @db.VarChar(100)
  merchant_name          String?            @db.VarChar(150)
  merchant_category_code String?            @db.VarChar(20)
  destination_account_id String?            @db.VarChar(100)
  status                 transaction_status @default(RECEIVED)
  created_at             DateTime           @default(now()) @db.Timestamptz(6)
  updated_at             DateTime           @default(now()) @db.Timestamptz(6)
  fraud_cases            fraud_cases?

  @@index([account_id, occurred_at(sort: Desc)], map: "idx_transactions_account_occurred_at")
  @@index([merchant_id], map: "idx_transactions_merchant")
  @@index([merchant_category_code], map: "idx_transactions_merchant_category")
  @@index([received_at(sort: Desc)], map: "idx_transactions_received_at")
  @@index([status], map: "idx_transactions_status")
}

enum fraud_case_status {
  OPEN
  IN_REVIEW
  CONFIRMED
  DISMISSED
}

enum rule_type {
  HIGH_VELOCITY
  ATYPICAL_AMOUNT
  IMPOSSIBLE_LOCATION
  RISKY_MERCHANT
}

enum transaction_status {
  RECEIVED
  PROCESSING
  SCORED
  FLAGGED
  FAILED
}

enum transaction_type {
  PURCHASE
  TRANSFER
  WITHDRAWAL
}
